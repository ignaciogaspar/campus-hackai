{
  "name": "campus-hackai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "lint:arreglar": "biome check --write .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "siu:seed": "tsx scripts/siu-seed.ts",
    "moodle:seed": "tsx scripts/moodle-seed.ts",
    "people:seed": "tsx scripts/people-seed.ts",
    "discord:probar": "node --env-file-if-exists=.env.local --import tsx scripts/discord-probar.ts",
    "demo:preparar": "node --env-file-if-exists=.env.local --import tsx scripts/demo-preparar.ts",
    "demo:verificar": "node --env-file-if-exists=.env.local --import tsx scripts/demo-verificar.ts",
    "demo:probar": "node --env-file-if-exists=.env.local --import tsx scripts/demo-probar.ts",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.71.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
