# Copiá este archivo a .env.local y completá los valores. Nunca commitees .env.local.

# Supabase (proyecto propio del equipo)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Solo para correr migraciones con psql
DATABASE_URL=

# Firma la cookie de sesión (hackai_session)
SESSION_SECRET=

# API de Claude
ANTHROPIC_API_KEY=

# Adaptador de cada puerto (lib/composition.ts). Vacío = memoria, con datos sintéticos.
HACKAI_IDENTITY=
HACKAI_SIU=
HACKAI_CLASSROOM=
HACKAI_EXTERNAL_CHANNEL=
HACKAI_FILES=
# memoria (reloj fijo en la fecha de los datos sintéticos) o sistema
HACKAI_CLOCK=
