# Copiá este archivo a .env.local y completá los valores. Nunca commitees .env.local.
# Son las mismas variables que pide campus/README.md.

# Supabase (proyecto propio del equipo, no el de Campus Austral)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo para correr migraciones con psql
DATABASE_URL=

# Firma la cookie de sesión (campus_session)
SESSION_SECRET=
# Código de ingreso del profesor
PROFESSOR_ACCESS_CODE=

# API de Claude
ANTHROPIC_API_KEY=

# Opcional: dominio público para QR y links
NEXT_PUBLIC_SITE_URL=
