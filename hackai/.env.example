# Copiá este archivo a .env.local y completá los valores. Nunca commitees .env.local.

# Supabase (proyecto propio del equipo)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Solo para npm run demo:preparar, que aplica los SQL con psql (README, «Base de la demo»)
DATABASE_URL=
# El ref del proyecto de Supabase de la demo (https://<ref>.supabase.co). Sin él, npm run demo:preparar se niega a tocar la base
HACKAI_DEMO_SUPABASE_REF=

# Firma la cookie de sesión (hackai_session)
SESSION_SECRET=

# Secreto de la corrida periódica (/api/cron/sync): el cron lo manda en «Authorization: Bearer …». README, «Corrida periódica»
CRON_SECRET=

# Adaptador de cada puerto (lib/composition.ts). Vacío = memoria, con datos sintéticos.
HACKAI_IDENTITY=
# memoria o simulado (tablas siu_* de Supabase: README, «SIU simulado»)
HACKAI_SIU=
# memoria o simulado (tablas moodle_* de Supabase: README, «Moodle simulado»)
HACKAI_CLASSROOM=
# memoria o discord (necesita DISCORD_BOT_TOKEN)
HACKAI_EXTERNAL_CHANNEL=
# memoria o supabase (bucket privado de Supabase Storage: README, «Espacio de la materia»)
HACKAI_FILES=
# memoria (reloj fijo en el martes 10/11 de los datos sintéticos, el de los tests) o sistema (la fecha real: el de la demo)
HACKAI_CLOCK=sistema
# Dónde guardan lo suyo Personas y Espacios: memoria o supabase (tablas de supabase/migrations/: README, «Vínculos de Personas en Supabase» y «Espacio de la materia»)
HACKAI_STORE=
# si: deja tirar el SIU o Moodle desde /caidas para mostrar en la demo que HackAI sigue andando (README, «Mostrar una caída en la demo»). Vacía o no: apagado, como en producción
HACKAI_CAIDAS=
# Cualquiera entra con su cuenta del SIU desde el ingreso (/entrar-con-siu). Vacía o si: prendido. no: solo personas de demo (README, «Entrar con tu cuenta real del SIU»)
HACKAI_SIU_REAL_PUBLICO=
# Opcional: una cuenta fija desde este archivo. si: la de SIU_SESION aparece primera en el ingreso de demo
HACKAI_SIU_REAL=
# La cookie siu_sess__portal_ua_UA de una sesión del SIU iniciada en el navegador. Vence: hay que volver a pegarla
SIU_SESION=
# La Autogestión del SIU, si no es https://siu.austral.edu.ar/portal
SIU_URL=
# Cada cuántos segundos se vuelve a leer el SIU real para mantener la pantalla en vivo. Vacía: 20
HACKAI_SIU_REAL_SEGUNDOS=
# Con una cuenta real, inscribirse, darse de baja y pedir constancias desde HackAI lo hace de verdad en el SIU (ADR 0009). Vacía o si: prendido. no: manda a la Autogestión
HACKAI_SIU_ESCRITURAS=
# Segundos que la caché de lecturas guarda lo que no cambia con lo que hace el alumno (README, «Variables»). Vacía: 300. 0: no guarda nada
HACKAI_CACHE_SEGUNDOS=

# Solo para los tests: base de prueba para las baterías de contrato del SIU y del Moodle simulados, de Archivos y de los almacenes de Personas y Espacios
HACKAI_TEST_SUPABASE_URL=
HACKAI_TEST_SUPABASE_SERVICE_ROLE_KEY=

# Token del bot de Discord (docs/discord.md). Lo usan HACKAI_EXTERNAL_CHANNEL=discord y npm run discord:probar
DISCORD_BOT_TOKEN=
# «Conectar con Discord» en el espacio: el Application ID y el Client Secret de la
# aplicación (Developer Portal → OAuth2). Sin ellos, los canales se vinculan pegando
# su enlace o su ID. El secreto va solo acá y en el hosting.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Opcional: la URL de vuelta, si no es <origen de la app>/discord/vuelta.
DISCORD_REDIRECT_URI=

# Asistente de secretaría en /cargar-clases (ADR 0010): claude o no (vacía = no). Con claude necesita ANTHROPIC_API_KEY.
HACKAI_ASSISTANT=
ANTHROPIC_API_KEY=
